    "**/src-tauri/gen/**": true,
    "**/src-tauri/ollama-bundle/**": true,
    "**/installer/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true
  },
  "files.watcherExclude": {
    "**/.tools/**": true,
    "**/src-tauri/target/**": true,
    "**/src-tauri/ollama-bundle/**": true,
    "**/installer/**": true
  },
