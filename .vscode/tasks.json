{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "tauri:build-debug",
      "detail": "Rust 셸을 디버그 프로필로 컴파일 (F5 디버깅용)",
      "type": "shell",
      "command": "cargo build",
      "options": { "cwd": "${workspaceFolder}/src-tauri" },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "tauri:dev",
      "detail": "npm run dev — 핫리로드로 앱 실행 (디버거 없이)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "tauri:build-release",
      "detail": "배포용 exe + NSIS 설치본 빌드",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "test",
      "detail": "node test.mjs — 순수 함수 단위 테스트",
      "type": "shell",
      "command": "node test.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
