{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "로컬 AI 채팅",
  "version": "0.1.0",
  "identifier": "com.localaichat.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "로컬 AI 채팅",
        "width": 1040,
        "height": 740,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "ollama-bundle/ollama.exe": "ollama/ollama.exe",
      "ollama-bundle/lib/ollama/*.dll": "ollama/lib/ollama/",
      "ollama-bundle/lib/ollama/*.exe": "ollama/lib/ollama/"
    }
  },
  "plugins": {}
}
